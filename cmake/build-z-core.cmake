# Preserve rustc's actual native dependencies instead of maintaining per-OS guesses.
string(REPLACE "|" ";" targets "${RUST_TARGETS}")
set(archives)
set(native_libs)
foreach(target IN LISTS targets)
  string(TOUPPER "${target}" target_env)
  string(REPLACE "-" "_" target_env "${target_env}")
  set(build_env "CARGO_TARGET_${target_env}_LINKER=${C_COMPILER}")
  if(DEPLOYMENT_TARGET)
    list(APPEND build_env "MACOSX_DEPLOYMENT_TARGET=${DEPLOYMENT_TARGET}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${build_env}
    "${CARGO}" rustc --manifest-path "${ZCORE_DIR}/Cargo.toml" --release --locked
    -p z180-c --lib --target "${target}" --target-dir "${OUT_DIR}/target"
    -- --print native-static-libs
    WORKING_DIRECTORY "${ZCORE_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "z-core ${target}:\n${output}\n${diagnostics}")
  endif()
  string(REGEX MATCH "native-static-libs: ([^\r\n]+)" native_match "${diagnostics}")
  if(NOT native_match)
    message(FATAL_ERROR "rustc did not report native static libraries:\n${diagnostics}")
  endif()
  set(target_libs "${CMAKE_MATCH_1}")
  if(NOT native_libs)
    set(native_libs "${target_libs}")
  elseif(NOT native_libs STREQUAL target_libs)
    # A universal link needs the dependencies of both archives; retain paired flags.
    string(APPEND native_libs " ${target_libs}")
  endif()
  list(APPEND archives "${OUT_DIR}/target/${target}/release/libz180.a")
endforeach()
list(LENGTH archives archive_count)
if(archive_count GREATER 1)
  execute_process(COMMAND lipo -create ${archives} -output "${OUT_DIR}/libz180.a" RESULT_VARIABLE result)
else()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different ${archives} "${OUT_DIR}/libz180.a" RESULT_VARIABLE result)
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "could not prepare the z-core static archive")
endif()
file(WRITE "${OUT_DIR}/native-libs.rsp" "${native_libs}\n")
file(TOUCH "${OUT_DIR}/libz180.a")
